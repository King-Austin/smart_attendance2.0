# ==========================================
# SMART CAMPUS PRESENCE - ENVIRONMENT CONFIG
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==========================================

# ------------------------------------------
# SUPABASE CREDENTIALS & DATABASE CONFIG
# ------------------------------------------
VITE_SUPABASE_URL=https://jtezcxkjjrrzqakrfukf.supabase.co
SUPABASE_URL=https://jtezcxkjjrrzqakrfukf.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_PROJECT_ID=jtezcxkjjrrzqakrfukf

# ------------------------------------------
# APPLICATION SERVER CONFIGURATION
# ------------------------------------------
NODE_ENV=development
VITE_APP_URL=http://localhost:5173
PORT=5173

# ------------------------------------------
# MOBILE / CAPACITOR CONFIG
# ------------------------------------------
VITE_API_BASE_URL=https://your-deployed-app.vercel.app
VITE_PUSH_TOKEN_ENDPOINT=https://your-deployed-app.vercel.app/api/push/register
# Same-origin by default (server route served from the same app); set only for
# static/mobile builds where the server route isn't served from the device.
# VITE_FACE_DUPLICATE_ENDPOINT=https://your-deployed-app.vercel.app/api/face/check-duplicate
VITE_APP_ENV=development
VITE_VAPID_PUBLIC_KEY=your-web-push-vapid-public-key

# ------------------------------------------
# BIOMETRIC & FACIAL RECOGNITION API
# ------------------------------------------
# InsightFace Docker node (http://localhost:8000 in dev; LAN IP for phones)
VITE_BIOMETRIC_API_URL=http://localhost:8000
BIOMETRIC_API_KEY=your-biometric-api-key-here

# ------------------------------------------
# GPS & GEOFENCING PARAMETERS
# ------------------------------------------
VITE_DEFAULT_GEOFENCE_RADIUS=100
VITE_MAX_GPS_ACCURACY_THRESHOLD=25
VITE_MAX_ANCHOR_ACCURACY=150
VITE_GPS_SAMPLE_COUNT=5
VITE_GPS_SAMPLE_INTERVAL_MS=1500

# ------------------------------------------
# SUPABASE MCP (used by .mcp.json, not the app)
# ------------------------------------------
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
SUPABASE_PROJECT_REF=jtezcxkjjrrzqakrfukf
